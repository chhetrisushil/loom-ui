{
  "name": "@loomwork/ui-planner",
  "version": "0.1.1",
  "description": "Planner SPI for loom-ui: intent + semantic catalogue + capabilities → operations, through ctx.decide; reference planner and conformance kit",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build && rm -rf dist/esm && tsc -p tsconfig.esm.json",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loomwork/ui-core": "workspace:^",
    "@loomwork/ui-hydration": "workspace:^",
    "@loomwork/blueprint-runtime": "^0.1.0",
    "@loomwork/classify": "^0.1.0",
    "@loomwork/core": "^0.1.0",
    "@loomwork/learning": "^0.1.0",
    "@loomwork/plugin-content": "^0.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loomwork/ui-renderer-terminal": "workspace:^",
    "@loomwork/plugin-mcp": "^0.1.0",
    "@loomwork/plugin-renderer-terminal": "^0.1.0",
    "@loomwork/plugin-sandbox": "^0.1.0",
    "@loomwork/projection-runtime": "^0.1.0",
    "@types/node": "catalog:",
    "typescript": "^5.6.3",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom-ui.git",
    "directory": "packages/planner"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.test-support.ts",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
