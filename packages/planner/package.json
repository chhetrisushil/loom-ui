{
  "name": "@loom-ui/planner",
  "version": "0.0.1",
  "description": "Planner SPI for loom-ui: intent + semantic catalogue + capabilities → operations, through ctx.decide; reference planner and conformance kit",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build && rm -rf dist/esm && tsc -p tsconfig.esm.json",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom-ui/core": "workspace:*",
    "@loom-ui/hydration": "workspace:*",
    "@loom/blueprint-runtime": "*",
    "@loom/classify": "*",
    "@loom/core": "*",
    "@loom/learning": "*",
    "@loom/plugin-content": "*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loom-ui/renderer-terminal": "workspace:*",
    "@loom/plugin-mcp": "*",
    "@loom/plugin-renderer-terminal": "*",
    "@loom/plugin-sandbox": "*",
    "@loom/projection-runtime": "*",
    "@types/node": "catalog:",
    "typescript": "^5.6.3",
    "vitest": "catalog:"
  }
}
