{
  "name": "@loomwork/ui-hydration",
  "version": "0.1.0",
  "description": "Provider-plane execution for loom-ui: resolves an Experience's handles through loom's transient effects and publishes them as one loom projection",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "node": "./dist/client.js",
      "import": "./dist/esm/client.js",
      "default": "./dist/client.js"
    }
  },
  "typesVersions": {
    "*": {
      "client": ["./dist/client.d.ts"]
    }
  },
  "scripts": {
    "build": "rm -f dist/split.js dist/split.js.map dist/split.d.ts dist/split.d.ts.map && tsc --build && rm -rf dist/esm && tsc -p tsconfig.esm.json",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loomwork/ui-core": "workspace:^",
    "@loomwork/agent": "^0.1.0",
    "@loomwork/classify": "^0.1.0",
    "@loomwork/core": "^0.1.0",
    "@loomwork/effect-runtime": "^0.1.0",
    "@loomwork/plugin-mcp": "^0.1.0",
    "@loomwork/plugin-sandbox": "^0.1.0",
    "@loomwork/projection-runtime": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.21.5",
    "typescript": "^5.6.3",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom-ui.git",
    "directory": "packages/hydration"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.test-support.ts",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
