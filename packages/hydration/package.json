{
  "name": "@loom-ui/hydration",
  "version": "0.0.1",
  "description": "Provider-plane execution for loom-ui: resolves an Experience's handles through loom's transient effects and publishes them as one loom projection",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" }
  },
  "typesVersions": {
    "*": { "client": ["./dist/client.d.ts"] }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom-ui/core": "workspace:*",
    "@loom/classify": "*",
    "@loom/core": "*",
    "@loom/effect-runtime": "*",
    "@loom/plugin-mcp": "*",
    "@loom/plugin-sandbox": "*",
    "@loom/projection-runtime": "*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.21.5",
    "typescript": "^5.6.3",
    "vitest": "catalog:"
  }
}
