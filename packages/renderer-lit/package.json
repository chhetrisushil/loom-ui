{
  "name": "@loom-ui/renderer-lit",
  "version": "0.0.1",
  "description": "loom DOM renderer adapter + Lit widgets registered under loom kinds; the framework's web surface beside loom's React renderer",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": ["./dist/register.js", "./dist/elements/*.js"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./dom": { "types": "./dist/dom/index.d.ts", "default": "./dist/dom/index.js" },
    "./containers": {
      "types": "./dist/dom/containers.d.ts",
      "default": "./dist/dom/containers.js"
    },
    "./media": { "types": "./dist/media.d.ts", "default": "./dist/media.js" },
    "./chat": { "types": "./dist/chat.d.ts", "default": "./dist/chat.js" },
    "./register": { "types": "./dist/register.d.ts", "default": "./dist/register.js" },
    "./elements/*": {
      "types": "./dist/elements/*.d.ts",
      "default": "./dist/elements/*.js"
    },
    "./signals": { "types": "./dist/signals.d.ts", "default": "./dist/signals.js" }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom-ui/core": "workspace:*",
    "@loom/blueprint-runtime": "*",
    "@loom/projection-runtime": "*",
    "lit": "catalog:"
  },
  "devDependencies": {
    "@loom-ui/hydration": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "0.21.5",
    "happy-dom": "catalog:",
    "typescript": "^5.6.3",
    "vitest": "catalog:"
  }
}
