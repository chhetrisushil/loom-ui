{
  "name": "@loomwork/ui-lineage",
  "version": "0.1.0",
  "description": "Experience lineage runtime for loom-ui: a head pointer per experience with compare-and-set advance, version walk, branch and revert as new versions, and the EXPERIENCE_COMPOSED/PROMOTED protocol with replay verification, over loom's ContentStore and an EventStore-shaped seam",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build && rm -rf dist/esm && tsc -p tsconfig.esm.json",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loomwork/ui-core": "workspace:^",
    "@loomwork/event-runtime": "^0.1.0",
    "@loomwork/plugin-content": "^0.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loomwork/ui-planner": "workspace:^",
    "@loomwork/plugin-crypto": "^0.1.0",
    "@types/node": "catalog:",
    "typescript": "^5.6.3",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom-ui.git",
    "directory": "packages/lineage"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.test-support.ts",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__golden__",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
