{
  "name": "@loom-ui/core",
  "version": "0.0.1",
  "description": "Experience Model, operations + replay, semantic catalogue, and the compiler to loom's Blueprint",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./browser": { "types": "./dist/browser.d.ts", "default": "./dist/browser.js" },
    "./log": { "types": "./dist/log.d.ts", "default": "./dist/log.js" },
    "./media": { "types": "./dist/media.d.ts", "default": "./dist/media.js" },
    "./chat": { "types": "./dist/chat.d.ts", "default": "./dist/chat.js" },
    "./chat-ui": { "types": "./dist/chatUi.d.ts", "default": "./dist/chatUi.js" },
    "./signals": { "types": "./dist/signals.d.ts", "default": "./dist/signals.js" }
  },
  "typesVersions": {
    "*": {
      "browser": ["./dist/browser.d.ts"],
      "log": ["./dist/log.d.ts"],
      "media": ["./dist/media.d.ts"],
      "chat": ["./dist/chat.d.ts"],
      "chat-ui": ["./dist/chatUi.d.ts"],
      "signals": ["./dist/signals.d.ts"]
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/blueprint-runtime": "*",
    "@loom/classify": "*",
    "@loom/core": "*",
    "@loom/plugin-content": "*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "^5.6.3",
    "vitest": "catalog:"
  }
}
