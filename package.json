{
  "name": "loom-ui",
  "version": "0.0.0",
  "private": true,
  "description": "A semantic UI framework for loom: an Experience Model that compiles to loom's Blueprint. Consumes the sibling ../loom checkout's unpublished @loomwork/* packages via pnpm.overrides (link:). See AGENTS.md.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:tests": "pnpm -r typecheck:tests",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@loomwork/agent": "link:../loom/packages/agent",
      "@loomwork/analytics": "link:../loom/packages/analytics",
      "@loomwork/blueprint-runtime": "link:../loom/packages/blueprint-runtime",
      "@loomwork/classify": "link:../loom/packages/classify",
      "@loomwork/core": "link:../loom/packages/core",
      "@loomwork/effect-runtime": "link:../loom/packages/effect-runtime",
      "@loomwork/event-runtime": "link:../loom/packages/event-runtime",
      "@loomwork/learning": "link:../loom/packages/learning",
      "@loomwork/plugin-content": "link:../loom/plugins/content",
      "@loomwork/plugin-crypto": "link:../loom/plugins/crypto",
      "@loomwork/plugin-mcp": "link:../loom/plugins/mcp",
      "@loomwork/plugin-renderer-terminal": "link:../loom/plugins/renderer-terminal",
      "@loomwork/plugin-sandbox": "link:../loom/plugins/sandbox",
      "@loomwork/projection-runtime": "link:../loom/packages/projection-runtime",
      "@loomwork/replay-vm": "link:../loom/packages/replay-vm",
      "@loomwork/scheduler": "link:../loom/packages/scheduler",
      "@loomwork/snapshot-runtime": "link:../loom/packages/snapshot-runtime",
      "@loomwork/workflow-runtime": "link:../loom/packages/workflow-runtime"
    }
  }
}
