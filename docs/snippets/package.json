{
  "name": "@loomwork/ui-docs-snippets",
  "version": "0.0.1",
  "description": "The compiling, asserted code behind docs/getting-started.md and docs/guides/*.md. Tests only; nothing here is published or imported.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loomwork/ui-changes": "workspace:*",
    "@loomwork/ui-core": "workspace:*",
    "@loomwork/ui-hydration": "workspace:*",
    "@loomwork/ui-learning": "workspace:*",
    "@loomwork/ui-lineage": "workspace:*",
    "@loomwork/ui-planner": "workspace:*",
    "@loomwork/ui-renderer-conformance": "workspace:*",
    "@loomwork/ui-renderer-lit": "workspace:*",
    "@loomwork/ui-renderer-terminal": "workspace:*",
    "@loomwork/blueprint-runtime": "*",
    "@loomwork/projection-runtime": "*",
    "@loomwork/core": "*",
    "@loomwork/plugin-content": "*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "lit": "catalog:",
    "typescript": "^5.6.3",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
